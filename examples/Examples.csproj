<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <RootNamespace>Nyra.Examples</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net.Interactions" Version="3.20.2" />
    <PackageReference
      Include="Microsoft.Extensions.Logging.Console"
      Version="10.0.15"
      Condition="'$(TargetFramework)' == 'net10.0'"
    />
    <PackageReference
      Include="Microsoft.Extensions.Logging.Console"
      Version="11.0.0"
      Condition="'$(TargetFramework)' == 'net11.0'"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Adapters\DiscordNet\Nyra.DiscordNet.csproj" />
    <ProjectReference Include="..\src\Nyra.csproj" />
  </ItemGroup>
</Project>
