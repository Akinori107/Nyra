<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Nyra</PackageId>
    <Description>A client for Lavalink v4.2+ and NodeLink v3.9+, with adapters for DSharpPlus, Discord.Net and NetCord.</Description>
    <PackageTags>discord;lavalink;nodelink;audio;music</PackageTags>
    <DefaultItemExcludes>$(DefaultItemExcludes);Adapters\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.3.177-beta" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference
      Include="Microsoft.Extensions.Logging.Abstractions"
      Version="10.0.15"
      Condition="'$(TargetFramework)' == 'net10.0'"
    />
    <PackageReference
      Include="Microsoft.Extensions.Logging.Abstractions"
      Version="11.0.0"
      Condition="'$(TargetFramework)' == 'net11.0'"
    />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Nyra.Tests" />
  </ItemGroup>
</Project>
