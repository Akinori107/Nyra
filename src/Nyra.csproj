<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Nyra</PackageId>
    <Description>A Lavalink v4.2+ and NodeLink v3.9+ client, bring the adapter for your Discord library.</Description>
    <PackageTags>discord;lavalink;nodelink;audio;music</PackageTags>
    <DefaultItemExcludes>$(DefaultItemExcludes);Clients\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>
</Project>
