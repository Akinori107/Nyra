<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <PackageId>Nyra.NetCord</PackageId>
    <Description>NetCord adapter for Nyra, a Lavalink v4.2+ and NodeLink v3.9+ client.</Description>
    <PackageTags>discord;lavalink;nodelink;audio;music;netcord</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Nyra.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NetCord" Version="1.0.0-beta.28" />
  </ItemGroup>
</Project>
